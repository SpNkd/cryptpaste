# Local development
API_PORT=8787
FRONTEND_PORT=5173
ALLOWED_ORIGINS=http://localhost:5173
STORAGE=memory

# Production build/deploy (do not commit real values)
VITE_API_BASE_URL=https://<api-gateway-domain>
VITE_BASE_PATH=/cryptpaste/

# YDB / Cloud Function runtime
YDB_CONNECTION_STRING=grpcs://ydb.serverless.yandexcloud.net:2135/?database=<database-path>
YDB_METADATA_CREDENTIALS=1
YDB_TABLE_PATH=pastes
